  m_Script: {fileID: 11500000, guid: f112c1a561f36bc4eb309a06360bedf4, type: 3}
  m_Name: 6AskingOutForLunch
  m_EditorClassIdentifier: Assembly-CSharp::ScenarioData
  scenarioID: 6
  scenarioName: Asking Out For Lunch
  sceneName: OutdoorHighschoolScene
  dialogueLines:
  - speakerName: 
    dialogueText: 'Imagine you were recently paired with someone for a group project
      who you find interesting and attractive. '
    typingSpeed: 0.03
  - speakerName: 
    dialogueText: 'You want to ask them out to lunch to get to know them better but
      you do not know how they might respond. '
    typingSpeed: 0.03
  - speakerName: 
    dialogueText: 'How likely are you to ask this person to have lunch with you? '
    typingSpeed: 0.03
  questionText: "How likely are you to ask this person to have lunch with you? \r\n"
