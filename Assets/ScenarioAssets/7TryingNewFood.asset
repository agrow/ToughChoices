  scenarioName: Trying New Food
  sceneName: OutdoorHighschoolScene
  dialogueLines:
  - speakerName: 
    dialogueText: 'Imagine you and your family are going out to eat at your favorite
      restaurant. '
    typingSpeed: 0.03
  - speakerName: 
    dialogueText: 'There is a new item on the menu that catches your attention. '
    typingSpeed: 0.03
  - speakerName: 
    dialogueText: "You want to try something new but you don\u2019t want to waste
      money on food you might not enjoy. "
    typingSpeed: 0.03
  - speakerName: 
    dialogueText: How likely are you to select the new dish?
    typingSpeed: 0.03
  questionText: 'How likely are you to select the new dish?

'
