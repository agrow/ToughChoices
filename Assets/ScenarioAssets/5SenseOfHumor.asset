  m_Script: {fileID: 11500000, guid: f112c1a561f36bc4eb309a06360bedf4, type: 3}
  m_Name: 5SenseOfHumor
  m_EditorClassIdentifier: Assembly-CSharp::ScenarioData
  scenarioName: 'Sense of Humor '
  sceneName: OutdoorHighschoolScene
  dialogueLines:
  - speakerName: 
    dialogueText: 'Imagine you are in a social gathering with people you are not
      very familiar with. '
    typingSpeed: 0.03
  - speakerName: 
    dialogueText: 'Suddenly, you thought of something funny to say, but you are unsure
      if others will understand your sense of humor. '
    typingSpeed: 0.03
  - speakerName: 
    dialogueText: How likely are you to tell these jokes?
    typingSpeed: 0.03
  questionText: How likely are you to tell these jokes?
