  m_Script: {fileID: 11500000, guid: 9ad7a19ae40d8294a81d7c71267873be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTester
  dialogueLines:
  - speakerName: ' '
    dialogueText: Imagine you are part of a student organization and a leadership
      position within that organization becomes available.
    typingSpeed: 0.03
  - speakerName: ' '
    dialogueText: 'You really want this position, but you have never taken on a leadership
      role before. Therefore, it is unknown whether you can manage the responsibilities. '
    typingSpeed: 0.03
  - speakerName: ' '
    dialogueText: 'Additionally, there are other members interested in this leadership
      position, so you do not know whether you will be selected. '
    typingSpeed: 0.03
  - speakerName: ' '
    dialogueText: How likely are you to apply for the leadership role?
    typingSpeed: 0.03
  choiceLabels:
  - VERY LIKELY
  - SOMEWHAT LIKELY
  - UNSURE
  - SOMEWHAT UNLIKELY
  - VERY UNLIKELY
